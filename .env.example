# Identité
BOT_NAME=ᴄᴜʀsɪㅤ愛
OWNER_NAME=ᴄᴜʀsɪㅤ愛
OWNER_NUMBER=242041029122

# Commandes et accès
PREFIX=.
MODE=private
TZ=Africa/Brazzaville
PAIRING_CODE=false
# Identité visuelle
AUTO_SET_PROFILE_PICTURE=true
PROFILE_PICTURE_PATH=assets/profile.jpg

# Profil fermé réservé aux essais contrôlés du propriétaire
CLOSED_TEST_MODE=false

# Commande adulte séparée .nsfw (désactivée par défaut)
NSFW_ENABLED=true

# Garde-fous d’utilisation responsable
SAFETY_ENABLED=true
ALLOW_PUBLIC_MODE=false
ALLOW_GROUP_AUTOMATION=false
ALLOW_STATUS_AUTOMATION=true
STARTUP_NOTIFICATION=true
FIRST_CONNECTION_WELCOME=true
SAFETY_COMMANDS_PER_USER_MINUTE=6
SAFETY_COMMANDS_PER_CHAT_MINUTE=12
SAFETY_COMMAND_BLOCK_SECONDS=60
SAFETY_OUTGOING_MIN_INTERVAL_MS=50
SAFETY_OUTGOING_CHAT_INTERVAL_MS=100
SAFETY_OUTGOING_PER_MINUTE=20
SAFETY_OUTGOING_PER_CHAT_MINUTE=8
SAFETY_OUTGOING_PER_DAY=300
SAFETY_MAX_QUEUE=50
SAFETY_STATUS_ACTIONS_PER_DAY=10

# Automatisations (désactivées par défaut)
AUTO_READ=true
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
STATUS_REACTION=❤️
ANTICALL=true

# Serveur
PORT=3000
LOG_LEVEL=info
# Stockage local par défaut. Avec DATABASE_URL/POSTGRES_URI, auto choisit PostgreSQL.
STORAGE_DRIVER=auto
BOT_INSTANCE_ID=default
DATABASE_URL=
DATABASE_SSL=auto
DATABASE_RETRIES=10
STORAGE_ENCRYPTION_KEY=
AUTH_DIR=.auth
DATA_DIR=data
MAX_DOWNLOAD_MB=50
# Moteur local sans clé; yt-dlp vérifié est installé dans data/tools au premier usage.
LOCAL_DOWNLOADER_ENABLED=true
LOCAL_DOWNLOAD_TIMEOUT_SECONDS=180
# Sessions WhatsApp secondaires isolées créées par .pairbot (0 à 3)
MAX_LINKED_BOTS=2
ALLOW_RESTART=false

# IA compatible OpenAI (facultatif)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1

# Téléchargements multimédias via une instance Cobalt autorisée/auto-hébergée (facultatif)
# Exemple d’auto-hébergement : https://github.com/imputnet/cobalt
COBALT_API_URL=
# Requis seulement si votre instance Cobalt impose une clé.
COBALT_API_KEY=
# Instances Cobalt publiques essayées en repli (séparées par des virgules).
# Ajouts prioritaires; les 5 replis publics restent actifs même sans COBALT_API_URL.
# api.cobalt.tools, co.wuk.sh, cobalt-api.kwiatekmiki.com, cobalt.dreamapi.cloud, api-cobalt.deno.dev
COBALT_INSTANCES=

# Recherche YouTube par titre : clé officielle OU API alternative que vous contrôlez.
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_API_URL=
# Valeurs : invidious ou piped
YOUTUBE_SEARCH_PROVIDER=invidious
# Instances Invidious prioritaires (séparées par des virgules), puis les 4 replis publics.
# inv.nadeko.net, invidious.nerdvpn.de, yewtu.be, invidious.jing.rocks
INVIDIOUS_INSTANCES=

# Recherche d’images multi-sources (séparées par des virgules).
# Valeurs possibles : openverse, commons, bing, pixabay, pexels, unsplash, loremflickr
IMAGE_PROVIDERS=openverse,commons,bing,pixabay,pexels,unsplash,loremflickr
# Clés facultatives : sans elles, les sources concernées sont simplement ignorées.
PIXABAY_API_KEY=
PEXELS_API_KEY=
