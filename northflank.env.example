# Variables à placer dans un Secret Group Northflank.
# DATABASE_URL est héritée de l’addon PostgreSQL : liez POSTGRES_URI avec l’alias DATABASE_URL.

BOT_NAME=ᴄᴜʀsɪㅤ愛
OWNER_NAME=ᴄᴜʀsɪㅤ愛
OWNER_NUMBER=24206XXXXXXX
BOT_INSTANCE_ID=principal

PREFIX=.
MODE=private
TZ=Africa/Brazzaville
PAIRING_CODE=true

AUTO_SET_PROFILE_PICTURE=true
PROFILE_PICTURE_PATH=assets/profile.jpg

# Profil de test fermé (laisser false sur une instance publique)
CLOSED_TEST_MODE=false

# Garde-fous Baileys
SAFETY_ENABLED=true
ALLOW_PUBLIC_MODE=false
ALLOW_GROUP_AUTOMATION=false
ALLOW_STATUS_AUTOMATION=false
STARTUP_NOTIFICATION=false
FIRST_CONNECTION_WELCOME=true
SAFETY_COMMANDS_PER_USER_MINUTE=6
SAFETY_COMMANDS_PER_CHAT_MINUTE=12
SAFETY_COMMAND_BLOCK_SECONDS=60
SAFETY_OUTGOING_MIN_INTERVAL_MS=1100
SAFETY_OUTGOING_CHAT_INTERVAL_MS=1800
SAFETY_OUTGOING_PER_MINUTE=20
SAFETY_OUTGOING_PER_CHAT_MINUTE=8
SAFETY_OUTGOING_PER_DAY=300
SAFETY_MAX_QUEUE=50
SAFETY_STATUS_ACTIONS_PER_DAY=10

STORAGE_DRIVER=postgres
DATABASE_SSL=auto
DATABASE_RETRIES=15
STORAGE_ENCRYPTION_KEY=REMPLACER_PAR_UNE_CLE_BASE64_DE_32_OCTETS

PORT=3000
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=320
MAX_DOWNLOAD_MB=40
LOCAL_DOWNLOADER_ENABLED=true
LOCAL_DOWNLOAD_TIMEOUT_SECONDS=180
MAX_LINKED_BOTS=2
ALLOW_RESTART=true

AUTO_READ=false
AUTO_VIEW_STATUS=false
AUTO_LIKE_STATUS=false
STATUS_REACTION=❤️
ANTICALL=false

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1
COBALT_API_URL=
COBALT_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_API_URL=
YOUTUBE_SEARCH_PROVIDER=invidious
